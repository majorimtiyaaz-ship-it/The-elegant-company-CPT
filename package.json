    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.563.0",
    "motion": "^12.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
